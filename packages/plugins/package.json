{
  "name": "@nilvn/plugins",
  "version": "0.2.0",
  "type": "module",
  "description": "The first-party NilVN plugins — text / character / screen / object effects, sprite animation, keyframe choreography, replays, the in-game menu — as runtime modules, manifests and a batteries-included engine bundle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nilzx/nilvn-plugins.git"
  },
  "keywords": [
    "nilvn",
    "visual-novel",
    "adv",
    "galgame",
    "plugins"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifests": "./src/manifests.ts",
    "./iife": "./dist/nilvn.iife.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./manifests": {
        "types": "./dist/manifests.d.ts",
        "import": "./dist/manifests.js"
      },
      "./iife": "./dist/nilvn.iife.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:lib && pnpm build:iife",
    "build:lib": "tsc -p tsconfig.lib.json",
    "build:iife": "node --experimental-strip-types scripts/build-iife.ts dist/nilvn.iife.js",
    "build:demo": "vite build",
    "preview": "vite preview",
    "bundle": "node scripts/bundle.mjs",
    "gen:audio": "node scripts/gen-audio.mjs",
    "typecheck": "tsc --noEmit && node scripts/check-boundary.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@nilvn/core": "^0.15.0",
    "@nilvn/engine": "^0.15.0"
  },
  "peerDependenciesMeta": {
    "@nilvn/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nilvn/core": "^0.15.0",
    "@nilvn/engine": "^0.15.0",
    "@nilvn/plugin-sdk": "^0.15.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "smol-toml": "^1.6.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
