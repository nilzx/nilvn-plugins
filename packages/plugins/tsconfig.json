{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "nilvn": [
        "./src/iife.ts"
      ]
    }
  },
  "include": [
    "src",
    "demo/main.ts",
    "vite.config.ts"
  ]
}
