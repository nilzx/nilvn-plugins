{
  "name": "nilvn-plugins",
  "private": true,
  "type": "module",
  "description": "NilVN's first-party plugins — @nilvn/plugins: runtime modules, manifests and the batteries-included engine bundle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nilzx/nilvn-plugins.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r build",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "version:set": "node scripts/set-version.mjs",
    "demo": "pnpm --filter @nilvn/plugins dev"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9"
  }
}
